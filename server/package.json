{
  "name": "nb-classic-scents-server",
  "version": "1.0.0",
  "description": "Backend API for NB Classic Scents",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
