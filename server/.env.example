PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/elegant-jewellery

# JWT secret used to sign auth tokens - replace with a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Comma-separated list of origins allowed to call this API
CLIENT_URL=http://localhost:5173

# Credentials used only by seed/seedProducts.js to create the first admin account
ADMIN_NAME=Elegant Admin
ADMIN_EMAIL=admin@elegantjewellery.com
ADMIN_PASSWORD=ChangeMe123!

# Optional: Cloudinary credentials (from cloudinary.com dashboard, free tier).
# When all three are set, admin-uploaded product images are stored in
# Cloudinary so they survive host restarts/redeploys (e.g. on Render's free
# tier, which wipes local disk on every restart). Leave blank for local dev -
# uploads then fall back to local disk under server/uploads/products/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
