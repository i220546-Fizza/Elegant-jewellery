PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/nb-classic-scents

# JWT secret used to sign auth cookies - use a long random string in production
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API (the first one is used in password-reset links)
CLIENT_URL=http://localhost:5173

# Used by `npm run seed` to create the first admin account
ADMIN_NAME=NB Admin
ADMIN_EMAIL=admin@nbclassicscents.com
ADMIN_PASSWORD=ChangeMe123!

# Shipping (PKR)
FREE_SHIPPING_THRESHOLD=20000
SHIPPING_FEE=450

# Optional: SMTP for password-reset and order emails. Without it, emails are
# logged to the console and (outside production) the reset token is returned
# to the browser so the flow still works locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=NB Classic Scents <hello@nbclassicscents.com>

# Optional: Cloudinary (cloudinary.com, free tier). When set, admin-uploaded
# images and 3D models are stored in Cloudinary so they survive redeploys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
