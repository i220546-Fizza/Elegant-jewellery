# MongoDB connection string.
# Local install:        mongodb://127.0.0.1:27017/layers-bakeshop
# MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/layers-bakeshop
MONGO_URI=mongodb://127.0.0.1:27017/layers-bakeshop

# Any long random string — used to sign login tokens. Change this for production.
JWT_SECRET=replace_with_a_long_random_string

PORT=5000
NODE_ENV=development

# Optional: only needed if you want admin-uploaded product images stored in
# Cloudinary instead of the local server/uploads/products folder. Leave blank
# to use local disk storage (works out of the box, no signup required).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used by the seed script to create the first admin account.
ADMIN_EMAIL=admin@layersbakeshop.com
ADMIN_PASSWORD=Admin@12345
